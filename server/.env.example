# MealMate server settings. install.sh writes the real .env for you.
# Never commit the real .env to GitHub.

# Shared code you and your partner type into the app once (at least 6 characters)
MEALMATE_CODE=change-me-please

# Your Spoonacular API key (leave blank to use TheMealDB only)
SPOONACULAR_API_KEY=

# The GitHub Pages address the app is served from (no trailing slash)
ALLOWED_ORIGINS=https://paulhessle-cyber.github.io

# Local port nginx forwards to
PORT=3100
